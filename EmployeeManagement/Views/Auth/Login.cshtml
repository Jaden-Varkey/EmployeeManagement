@{
    Layout = null;
    var returnUrl = ViewBag.ReturnUrl as string ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in — Employee Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        body { background-color: #f4f7f6; }
        .login-card { max-width: 400px; margin: 8% auto; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Sign in</h4>
            </div>
            <div class="card-body">
                <form id="loginForm">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Username</label>
                        <input type="text" id="username" class="form-control" autocomplete="username" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Password</label>
                        <input type="password" id="password" class="form-control" autocomplete="current-password" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100 fw-bold">Sign in</button>
                </form>
            </div>
        </div>
    </div>

    <script>
        // Where to go after a successful login. Sanitized server-side on the GET; kept as-is here.
        const RETURN_URL = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(returnUrl));

        $('#loginForm').on('submit', function (e) {
            e.preventDefault();
            $.ajax({
                url: '/Auth/Login',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    Username: $('#username').val(),
                    Password: $('#password').val()
                })
            }).done(function () {
                // Cookies are set; navigate into the app (top-level GET carries the cookie).
                window.location.href = RETURN_URL && RETURN_URL.charAt(0) === '/' ? RETURN_URL : '/';
            }).fail(function (xhr) {
                var msg = (xhr.responseJSON && xhr.responseJSON.message) || 'Login failed.';
                Swal.fire({ title: 'Sign in failed', text: msg, icon: 'error' });
            });
        });
    </script>
</body>
</html>
